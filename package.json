{
  "name": "topstatsaio",
  "version": "3.0.3",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:update": "electron . --dev-update",
    "debug": "electron . --keep-temp",
    "test": "jest",
    "dist": "node scripts/build-win.js",
    "dist:linux": "node scripts/build-linux.js",
    "dist:all": "node scripts/build-win.js && node scripts/build-linux.js --no-clean",
    "clear-settings": "node scripts/clear-settings.js",
    "fake-update": "electron . --fake-update"
  },
  "keywords": [],
  "author": "Darkharasho <darkharasho@users.noreply.github.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "jest": "^29.7.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "semver": "^7.7.2"
  },
  "build": {
    "appId": "com.topstatsaio.app",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "media/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "flatpak"
      ],
      "category": "Utility",
      "icon": "media/TopStatsAIO-Logo.png",
      "desktop": {
        "StartupWMClass": "TopStatsAIO"
      }
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "23.08"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}