{
  "name": "topstatsaio",
  "version": "2.4.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron . --keep-temp",
    "test": "jest",
    "dist": "node scripts/build-win.js",
    "dist:linux": "electron-builder --linux deb rpm flatpak",
    "clear-settings": "node scripts/clear-settings.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "semver": "^7.7.2"
  },
  "build": {
    "appId": "com.topstatsaio.app",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "media/TopStatsAIO-Logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "flatpak"
      ],
      "icon": "media/TopStatsAIO-Logo.png",
      "category": "Utility"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "23.08",
      "finishArgs": [
        "--share=network",
        "--socket=x11",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=home"
      ]
    }
  }
}
